{
  "headers": [
    { "source": "/data.enc.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/(|index.html|app.js|app.css)", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
